# Zenoh router used by the robot bridges. Set its LAN IP/hostname here.
# For a router on this Docker host, use host.docker.internal.
# 127.0.0.1 refers to the container itself.
ZENOH_ROUTER_ENDPOINT=tcp/host.docker.internal:7447

# For remote browsers, replace localhost with the Docker host's LAN IP/hostname.
WEB_PORT=8080
RMF_PUBLIC_URL=http://localhost:8080
WEB_BIND_ADDRESS=0.0.0.0
TZ=Asia/Kolkata

# Robot ROS domains can differ: robots use Zenoh.
ROS_DOMAIN_ID=52

# Same Jazzy revision for API and dashboard.
RMF_WEB_REF=dbee3f9e27ba2f9313db68078428754b715bf0ba

# Optional: published image instead of the locally built tag.
# RMF_IMAGE=ghcr.io/escher-bach/jetracer-rmf:jazzy
