<?xml version='1.0' ?>

<!--
  RMF core (traffic schedule, blockade moderator, building map server,
  visualizer/RViz, door + lift supervisors, task dispatcher) for the jetracer
  fleet.

  This is a thin wrapper over free_fleet_examples' include/rmf_common.launch.xml
  with the jetracer building map pinned, so the bring-up command is

    ros2 launch jetracer_fleet jetracer_rmf_core.launch.xml

  instead of the four-line `$(ros2 pkg prefix free_fleet_examples)/share/...`
  invocation the runbooks used to carry. free_fleet is not modified; this only
  supplies arguments to its launch file.

  server_uri is the piece that matters for rmf-web: rmf_common.launch.xml passes
  it through to rmf_task_dispatcher, which is what publishes task state to the
  API server. Leave it empty for the RViz-only flow.
-->
<launch>
  <arg name="server_uri" default="" description="URI of the rmf-web api server, e.g. ws://localhost:8000/_internal. Empty disables reporting."/>
  <arg name="config_file" default="$(find-pkg-share jetracer_fleet)/maps/jetracer/jetracer.building.yaml"/>
  <arg name="viz_config_file" default="$(env HOME)/ff_ws/rviz_configs/rmf_fixed.rviz" description="RViz config; see rviz-map-visualization-debugging.md for why this is not the stock rmf.rviz."/>
  <arg name="headless" default="false" description="true skips RViz -- useful when the rmf-web dashboard is the only front end you need."/>
  <arg name="initial_map" default="L1"/>
  <arg name="use_sim_time" default="false"/>

  <!-- NOTE the missing `launch/`: free_fleet_examples installs with
       `install(DIRECTORY launch/ DESTINATION share/${PROJECT_NAME})`, which
       flattens the contents of launch/ into the share root. The installed path
       is share/free_fleet_examples/include/rmf_common.launch.xml, with no
       intervening launch/ directory. -->
  <include file="$(find-pkg-share free_fleet_examples)/include/rmf_common.launch.xml">
    <arg name="config_file" value="$(var config_file)"/>
    <arg name="viz_config_file" value="$(var viz_config_file)"/>
    <arg name="headless" value="$(var headless)"/>
    <arg name="initial_map" value="$(var initial_map)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="server_uri" value="$(var server_uri)"/>
  </include>
</launch>
