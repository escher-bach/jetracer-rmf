+    def _request_replan(self, reason: str) -> None:
+        # Every replan this adapter asks for produces a fresh plan, which
+        # enters the traffic schedule and can trigger a fresh negotiation.
+        # When nav2 aborts a goal the instant it is accepted -- which is what
+        # happens when another robot is sitting on the target -- the unguarded
+        # path here is: abort -> replan -> new goal -> abort, several times a
+        # second, with a negotiation attempt behind each one. The cooldown
+        # breaks that hot loop.
+        #
+        # This bounds the churn the adapter contributes. It cannot stop RMF's
+        # own forfeit -> "failed to negotiate" -> replan cycle, which lives in
+        # rmf_fleet_adapter and is only really cured by not having two robots
+        # contend for the same waypoint.
+        if self.update_handle is None:
+            self.node.get_logger().error(
+                f'Failed to replan for robot {self.name}, robot adapter has '
+                'not yet been initialized with a fleet update handle.'
+            )
+            return
+
+        now_sec = self.node.get_clock().now().nanoseconds / 1e9
+        if self.replan_cooldown_sec > 0.0 \
+                and self.last_replan_time_sec is not None \
+                and now_sec - self.last_replan_time_sec \
+                < self.replan_cooldown_sec:
+            self.node.get_logger().warn(
+                f'Suppressing replan for [{self.name}] ({reason}): previous '
+                f'request was {now_sec - self.last_replan_time_sec:.2f}s ago, '
+                f'cooldown is {self.replan_cooldown_sec}s'
+            )
+            return
+
+        self.last_replan_time_sec = now_sec
+        self.update_handle.more().replan()
+
+    def _is_redundant(self, destination: rmf_easy.Destination) -> bool:
+        # Compare waypoint identity, never pose.
+        #
+        # With responsive_wait enabled, RMF re-issues a go_to_place for the
+        # waypoint an idle robot is already parked on every 30s (its hardcoded
+        # ResponsiveWait update_period) whenever the reported pose is not
+        # exactly on that point. Ours settle ~0.2m off, so it fires forever,
+        # and each re-issue carries a freshly planned yaw -- which on an
+        # Ackermann chassis is a multi-point turn, not a spin. The robots never
+        # rest.
+        #
+        # Keying on the nav graph index means there is no "close enough"
+        # threshold to tune and no risk of suppressing a real move: either RMF
+        # is naming the waypoint the robot last arrived at, in which case the
+        # command asks for nothing, or it is naming a different waypoint and
+        # the robot drives. A robot being asked to yield is always being sent
+        # to a different waypoint, so yielding is untouched.
+        if destination.dock is not None:
+            return False
+        if destination.graph_index is None:
+            return False
+        return destination.graph_index == self.last_reached_graph_index
+
